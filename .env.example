# LintBench — API keys
# Copy to .env and fill in the keys for the providers you use.

# OpenAI (gpt-4o, o1, o3, ...)
OPENAI_API_KEY=

# Anthropic (claude-*)
ANTHROPIC_API_KEY=

# Google (gemini-*)
GOOGLE_API_KEY=

# OpenRouter — access any model with one key (openai/*, anthropic/*, meta-llama/*, ...)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
